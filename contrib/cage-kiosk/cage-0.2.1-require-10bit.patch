@@ -12,6 +12,7 @@
 #include "config.h"
 
 #include <assert.h>
+#include <drm_fourcc.h>
 #include <stdlib.h>
 #include <unistd.h>
 #include <wayland-server-core.h>
@@ -46,6 +47,30 @@
 	(WLR_OUTPUT_STATE_ENABLED | WLR_OUTPUT_STATE_MODE | WLR_OUTPUT_STATE_SCALE | WLR_OUTPUT_STATE_TRANSFORM |      \
 	 WLR_OUTPUT_STATE_ADAPTIVE_SYNC_ENABLED)
 
+static bool
+output_require_10bit_render_format(struct wlr_output *output, struct wlr_output_state *state)
+{
+	static const struct {
+		uint32_t format;
+		const char *name;
+	} formats[] = {
+		{DRM_FORMAT_XRGB2101010, "XR30"},
+		{DRM_FORMAT_XBGR2101010, "XB30"},
+	};
+
+	for (size_t i = 0; i < sizeof(formats) / sizeof(formats[0]); ++i) {
+		wlr_output_state_set_render_format(state, formats[i].format);
+		if (wlr_output_test_state(output, state)) {
+			wlr_log(WLR_INFO, "Output %s is using required 10-bit render format %s", output->name,
+				formats[i].name);
+			return true;
+		}
+	}
+
+	wlr_log(WLR_ERROR, "Output %s supports neither XR30 nor XB30; refusing 8-bit fallback", output->name);
+	return false;
+}
